# Copy this file to `.env` and fill in your own credentials.
# `.env` is git-ignored and must never be committed.

# Google AI Studio key, used for both the dramatizer (Gemini text) and the
# text-to-speech step. Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Perplexity key, used by the news finder and the script generator.
# Get one at https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# Shared secret required in the `x-token` header of POST /produce.
# Generate a random value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`
API_AUTH_TOKEN=

# Supabase project credentials. Only needed to run the REST API (src/api.py);
# the standalone pipelines work without them.
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=
SUPABASE_KEY=
